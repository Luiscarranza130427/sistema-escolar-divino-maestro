# Copiar como .env y completar con los datos reales. .env está excluido de Git.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sistema_escolar
DB_USER=postgres
DB_PASSWORD=cambia_esta_contraseña

# true solo en desarrollo: incluye el mensaje real de los errores 500 en la respuesta.
APP_DEBUG=false

# Orígenes del frontend permitidos, separados por comas (por ejemplo http://localhost:5173).
APP_CORS_ORIGINS=

# Horas de inactividad tras las que vence un token de acceso (se renueva con el uso).
APP_TOKEN_HORAS=12
