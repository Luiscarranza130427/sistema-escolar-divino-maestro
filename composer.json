{
    "name": "colegio/sistema-escolar-api",
    "description": "API REST del sistema escolar (PHP por capas + PostgreSQL).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "migrar": "php bin/migrar.php",
        "servir": "php -S 127.0.0.1:8000 -t public"
    },
    "config": {
        "sort-packages": true
    }
}
